{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
    "store:default",
    "process:allow-restart",
    "process:allow-exit",
    "dialog:default",
    "updater:default",
    "notification:default",
    "log:allow-log"
  ]
}
