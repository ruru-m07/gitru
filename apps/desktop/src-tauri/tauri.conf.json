{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitru",
  "version": "0.1.0",
  "identifier": "com.ruru.gitru",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gitru",
        "width": 1600,
        "height": 870,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 19,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "macOS": {
      "dmg": {
        "background": "../public/assets/dmg-background.png",
        "windowPosition": {
          "x": 230,
          "y": 150
        },
        "appPosition": {
          "x": 400,
          "y": 438
        },
        "applicationFolderPosition": {
          "x": 1092,
          "y": 438
        },
        "windowSize": {
          "height": 760,
          "width": 1492
        }
      },
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    },
    "active": true,
    "targets": ["dmg", "msi", "appimage", "nsis", "rpm", "deb", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
