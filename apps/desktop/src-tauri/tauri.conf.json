{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitru Runtime Qualification",
  "version": "../package.json",
  "identifier": "com.ruru.gitru.cef-qualification",
  "build": {
    "beforeDevCommand": "bun run dev:qualification",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:qualification",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gitru",
        "width": 1600,
        "height": 870,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "zoomHotkeysEnabled": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 23
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost blob: data: https://avatars.githubusercontent.com https://github.com https://bitbucket.org; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1421 ws://127.0.0.1:1421"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "macOS": {
      "dmg": {
        "background": "assets/dmg-background.png",
        "appPosition": {
          "x": 180,
          "y": 140
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 140
        }
      },
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "active": true,
    "targets": ["dmg", "appimage", "nsis", "rpm", "deb", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
