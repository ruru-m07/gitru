{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitru",
  "version": "../package.json",
  "identifier": "com.ruru.gitru",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gitru",
        "width": 1600,
        "height": 870,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 19,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "macOS": {
      "dmg": {
        "background": "assets/dmg-background.png",
        "appPosition": {
          "x": 180,
          "y": 140
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 140
        }
      },
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    },
    "active": true,
    "targets": ["dmg", "msi", "appimage", "nsis", "rpm", "deb", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ruru-m07/gitru/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMDQ0NTEwODlBNjAzMEEKUldRS0E2YUpFRVVFMDlzQzFkdExDRWJFbWRlUEkxcURnZFpiNktsZ0lOMllLNVh0aVljL0ZWZm8K"
    }
  }
}
