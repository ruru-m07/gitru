{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitru E2E",
  "identifier": "com.ruru.gitru.e2e",
  "build": {
    "beforeBuildCommand": "bun run build:e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gitru",
        "url": "/app",
        "width": 1280,
        "height": 800,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "capabilities": ["main", "child-tabs"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
