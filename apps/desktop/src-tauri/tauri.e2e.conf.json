{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitru E2E",
  "identifier": "com.ruru.gitru.e2e",
  "build": {
    "beforeBuildCommand": "bun run build:e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gitru",
        "url": "/app/git?embedded=1",
        "width": 1280,
        "height": 800,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "capabilities": [
        "main",
        "child-tabs",
        {
          "identifier": "e2e-wdio",
          "description": "WebDriver access compiled only into the isolated E2E build",
          "webviews": ["main"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false
  }
}
