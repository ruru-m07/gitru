digraph Dependencies {
  rankdir=LR;
  node [shape=box];

  "my_custom_command" [color=blue, style=filled, fillcolor=lightblue];
  "add" [color=blue, style=filled, fillcolor=lightblue];
  "get_status" [color=blue, style=filled, fillcolor=lightblue];
  "get_status_single_file" [color=blue, style=filled, fillcolor=lightblue];
  "GetStatusResponse" [color=green];
  "FileStatus" [color=green];
  "get_status" -> "GetStatusResponse" [label="return"];
  "get_status_single_file" -> "FileStatus" [label="return"];
  "GetStatusResponse" -> "FileStatus";
}
