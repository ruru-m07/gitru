{
  "name": "gitru-web",
  "private": true,
  "packageManager": "bun@1.3.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "bun install --frozen-lockfile && vite build && cp dist/client/_shell.html dist/client/index.html",
    "start": "serve -s dist/client",
    "preview": "bun run build && wrangler pages dev dist/client",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "deploy": "bun run build && wrangler pages deploy dist/client --project-name gitru",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@cloudflare/vite-plugin": "^1.26.1",
    "@elysiajs/eden": "^1.4.5",
    "@fontsource-variable/geist": "^5.2.8",
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-presence": "^1.1.5",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tanstack/react-router": "1.163.3",
    "@tanstack/react-router-devtools": "1.163.3",
    "@tanstack/react-start": "1.164.0",
    "@tanstack/start-static-server-functions": "1.164.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.6.9",
    "fumadocs-mdx": "14.2.9",
    "fumadocs-ui": "16.6.9",
    "lucide-react": "^0.577.0",
    "motion": "^12.35.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "scroll-into-view-if-needed": "^3.1.0",
    "shadcn": "^4.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.1",
    "wrangler": "^4.71.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "nitro": "npm:nitro-nightly@3.0.1-20260128-211656-ae83c97e",
    "serve": "^14.2.5",
    "srvx": "^0.11.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
