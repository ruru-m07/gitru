+// Gitru qualification-only adaptation. Closure captures are never formatted.
+pub(crate) type BeforeInitialize = Arc<DebugFn<dyn Fn() -> Result<Box<dyn SqliteNativeHandleOwner>, sqlx_core::error::Error> + Send + Sync>>;
+
+/// Per-handle native owner retained through actual SQLite close.
+///
+/// # Safety
+/// `initialize` receives exclusive access before extensions or SQL. It must not
+/// close/retain the pointer or leak native statements/backups. Both callbacks
+/// must finish, must not panic, and must not expose secrets in diagnostics.
+/// `close_failed` must permanently retire its owning factory from admission.
+pub unsafe trait SqliteNativeHandleOwner: std::fmt::Debug + Send + Sync {
+    fn initialize(&self, handle: std::ptr::NonNull<libsqlite3_sys::sqlite3>) -> Result<(), sqlx_core::error::Error>;
+    fn close_failed(&self);
+}
 
