{
  "name": "gitru",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "bun run lint:testing && turbo run lint",
    "lint:testing": "biome check vitest.config.ts tests tsconfig.testing.json",
    "format": "biome check --write",
    "check-types": "bun run check-types:testing && turbo run check-types",
    "check-types:testing": "tsc --noEmit --project tsconfig.testing.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "^2.8.10",
    "typescript": "catalog:",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "typescript": "^5",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "recharts": "^3.8.1",
      "@tauri-apps/api": "^2.10.1",
      "react-resizable-panels": "4",
      "lucide-react": "^0.577.0",
      "zod": "^4.3.5"
    }
  }
}
